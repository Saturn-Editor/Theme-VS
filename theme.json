{
  "id": "vs",
  "name": "VS",
  "version": "1.0.0",
  "description": "A theme based on Visual Studio.",
  "light": {
    "colors": {
      "app": "neutral-100",
      "editor": "white",
      "panel": "neutral-50",
      "raised": "white",
      "divider": "neutral-200",
      "border": "neutral-300",
      "text": "neutral-800",
      "strong": "neutral-950",
      "muted": "neutral-500",
      "accent": "sky-600",
      "on-accent": "white",
      "selection": "sky-200/70",
      "hover": "black/5"
    },
    "syntax": [
      { "scope": "comment", "color": "green-700" },
      { "scope": "string", "color": "red-800" },
      { "scope": "string.regexp", "color": "rose-900" },
      { "scope": "constant.character.escape", "color": "red-600" },
      { "scope": "constant.numeric", "color": "emerald-700" },
      { "scope": "constant.language", "color": "blue-700" },
      { "scope": "keyword", "color": "blue-700" },
      { "scope": "keyword.control", "color": "purple-700" },
      { "scope": "keyword.operator", "color": "neutral-700" },
      { "scope": "storage", "color": "blue-700" },
      { "scope": "meta.preprocessor", "color": "neutral-500" },
      { "scope": "entity.name.function", "color": "yellow-800" },
      { "scope": "support.function", "color": "yellow-800" },
      { "scope": "entity.name.type", "color": "cyan-700" },
      { "scope": "entity.name.class", "color": "cyan-700" },
      { "scope": "support.type", "color": "cyan-700" },
      { "scope": "support.class", "color": "cyan-700" },
      { "scope": "entity.name.namespace", "color": "neutral-800" },
      { "scope": "entity.name.tag", "color": "red-900" },
      { "scope": "entity.other.attribute-name", "color": "red-600" },
      { "scope": "variable", "color": "blue-900" },
      { "scope": "variable.language", "color": "blue-700" },
      { "scope": "punctuation", "color": "neutral-800" },
      { "scope": "markup.heading", "color": "blue-800", "fontStyle": "bold" },
      { "scope": "markup.bold", "color": "neutral-800", "fontStyle": "bold" },
      { "scope": "markup.italic", "color": "neutral-800", "fontStyle": "italic" },
      { "scope": "markup.inline.raw", "color": "red-800" },
      { "scope": "markup.underline.link", "color": "sky-700" },
      { "scope": "markup.quote", "color": "green-700" },
      { "scope": "markup.list", "color": "neutral-500" }
    ]
  },
  "dark": {
    "colors": {
      "app": "neutral-800",
      "editor": "neutral-900",
      "panel": "neutral-800",
      "raised": "neutral-700",
      "divider": "neutral-700",
      "border": "neutral-600",
      "text": "neutral-200",
      "strong": "white",
      "muted": "neutral-400",
      "accent": "sky-600",
      "on-accent": "white",
      "selection": "sky-800/60",
      "hover": "white/10"
    },
    "syntax": [
      { "scope": "comment", "color": "green-600" },
      { "scope": "string", "color": "orange-300" },
      { "scope": "string.regexp", "color": "red-400" },
      { "scope": "constant.character.escape", "color": "amber-200" },
      { "scope": "constant.numeric", "color": "green-200" },
      { "scope": "constant.language", "color": "blue-400" },
      { "scope": "keyword", "color": "blue-400" },
      { "scope": "keyword.control", "color": "purple-300" },
      { "scope": "keyword.operator", "color": "neutral-400" },
      { "scope": "storage", "color": "blue-400" },
      { "scope": "meta.preprocessor", "color": "neutral-400" },
      { "scope": "entity.name.function", "color": "yellow-100" },
      { "scope": "support.function", "color": "yellow-100" },
      { "scope": "entity.name.type", "color": "teal-400" },
      { "scope": "entity.name.class", "color": "teal-400" },
      { "scope": "support.type", "color": "teal-400" },
      { "scope": "support.class", "color": "teal-400" },
      { "scope": "entity.name.namespace", "color": "neutral-200" },
      { "scope": "entity.name.tag", "color": "blue-400" },
      { "scope": "entity.other.attribute-name", "color": "sky-200" },
      { "scope": "variable", "color": "sky-200" },
      { "scope": "variable.language", "color": "blue-400" },
      { "scope": "punctuation", "color": "neutral-300" },
      { "scope": "markup.heading", "color": "blue-400", "fontStyle": "bold" },
      { "scope": "markup.bold", "color": "neutral-200", "fontStyle": "bold" },
      { "scope": "markup.italic", "color": "neutral-200", "fontStyle": "italic" },
      { "scope": "markup.inline.raw", "color": "orange-300" },
      { "scope": "markup.underline.link", "color": "sky-300" },
      { "scope": "markup.quote", "color": "green-600" },
      { "scope": "markup.list", "color": "neutral-400" }
    ]
  }
}
